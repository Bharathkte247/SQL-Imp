# Application
APP_PORT=3000
MAX_QUERY_ROWS=500

# Active database profile: demo | clickhouse | postgres | mysql | mssql
DB_TYPE=demo

# Shared service-account credentials (used by cloud and on-prem profiles)
DB_HOST=localhost
DB_PORT=
DB_NAME=wfm
DB_USER=wfm_service
DB_PASSWORD=
DB_SSL=false

# Optional ClickHouse-specific overrides
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=wfm_service
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=wfm

# Optional Postgres overrides
PGHOST=localhost
PGPORT=5432
PGDATABASE=wfm
PGUSER=wfm_service
PGPASSWORD=

# Optional MySQL overrides
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=wfm
MYSQL_USER=wfm_service
MYSQL_PASSWORD=

# Optional SQL Server overrides
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=wfm
MSSQL_USER=wfm_service
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
